{
  "name": "dsh-simplify-path",
  "version": "0.1.3",
  "description": "统一简化 DeepSeek Harness Web 的文件路径显示",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client.js",
    "dist/THIRD-PARTY-LICENSES.txt",
    "src/host.js",
    "src/preferences.js",
    "cordis.patch.yml",
    "locale/",
    "manual/"
  ],
  "keywords": ["dsh-plugin", "deepseek-harness", "file-paths"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "external": ["react", "@deepseek-ai/dsh-client-ui-primitives"] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "test:web": "node test/web.mjs",
    "package:plugin": "node scripts/package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "~0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "~0.2.3-alpha.2",
    "esbuild": "0.27.0",
    "playwright-core": "1.64.1",
    "ws": "8.23.0"
  }
}
